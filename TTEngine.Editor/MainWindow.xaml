<Window x:Class="TTEngine.Editor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TTEngine.Editor"
        xmlns:panels="clr-namespace:TTEngine.Editor.Panels"
        mc:Ignorable="d"
        Title="TTEngine Editor"
        Height="700"
        Width="1200"
        KeyDown="Window_KeyDown">

    <Grid>

        <!-- ROOT GRID -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <!-- Left Panel -->
            <ColumnDefinition Width="*"/>
            <!-- Scene -->
            <ColumnDefinition Width="5"/>
            <!-- Splitter-->
            <ColumnDefinition Width="350"/>
            <!-- Right Panels -->
        </Grid.ColumnDefinitions>

        <!-- ===================================== -->
        <!-- LEFT SIDE -->
        <!-- ===================================== -->

        <Grid Grid.Column="0">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Scene selector -->
                <RowDefinition Height="*"/>
                <!-- Toolbar -->
            </Grid.RowDefinitions>

            <!-- Scene Selection Panel -->
            <panels:ScenePanel x:Name="ScenePanel" Grid.Row="0"/>

            <!-- Toolbar -->
            <Border Grid.Row="1" Background="#2A2A2A">
                <panels:TileToolPanel x:Name="TileTools"/>
            </Border>

        </Grid>

        <!-- ===================================== -->
        <!-- SCENE VIEW -->
        <!-- ===================================== -->

        <Border Grid.Column="1" Background="#1E1E1E">

            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          PreviewMouseWheel="Canvas_MouseWheel">

                <Canvas x:Name="MapCanvas"
                        Background="Transparent"
                        MouseDown="Canvas_MouseDown"
                        MouseMove="Canvas_MouseMove"
                        MouseUp="Canvas_MouseUp"/>

            </ScrollViewer>

        </Border>

        <!-- Splitter -->
        <GridSplitter Grid.Column="2"
                      Width="5"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="#444"
                      ShowsPreview="True"/>

        <!-- ===================================== -->
        <!-- RIGHT SIDE PANELS -->
        <!-- ===================================== -->

        <Grid Grid.Column="3">

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="250"/>
            </Grid.RowDefinitions>

            <!-- TOP RIGHT -->
            <Grid Grid.Row="0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Hierarchy / Animator -->
                <TabControl Grid.Column="0" x:Name="TopLeftTab"></TabControl>

                <!-- Splitter -->
                <GridSplitter Grid.Column="1"
                              Width="5"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Background="#444"
                              ShowsPreview="True"/>

                <!-- Inspector / Animation -->
                <TabControl Grid.Column="2" x:Name="TopRightTab">

                    <TabItem Header="Inspector">
                        <panels:InspectorPanel x:Name="Inspector"/>
                    </TabItem>
                </TabControl>

            </Grid>

            <!-- BOTTOM RIGHT -->
            <TabControl Grid.Row="1" x:Name="BottomTabPanel">
                <TabItem Header="Console">
                    <panels:EditorConsolePanel x:Name="ConsoleEditor"/>
                </TabItem>

            </TabControl>

        </Grid>

    </Grid>
</Window>