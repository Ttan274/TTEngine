<UserControl x:Class="TTEngine.Editor.Panels.AssetPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:assets="clr-namespace:TTEngine.Editor.Models.Asset"
             xmlns:local="clr-namespace:TTEngine.Editor.Converter">

    <UserControl.Resources>
        <local:AssetIconConverter x:Key="IconConverter"/>
        <local:InverseBoolConverter x:Key="InverseBoolConverter"/>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>

    <Border Background="#2B2B2B" Padding="6">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <TextBlock Text="ASSETS"
               Foreground="White"
               FontWeight="Bold"
               Margin="0,0,0,6"/>

            <!-- TREE -->
            <TreeView x:Name="AssetTree"
                      Grid.Row="1"
                      Background="#2B2B2B"
                      BorderThickness="0"
                      Foreground="White"
                      MouseDoubleClick="DoubleClicked">

                <TreeView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="New Folder"
                                  Click="NewFolder_Click"/>
                    </ContextMenu>
                </TreeView.ContextMenu>

                <TreeView.Resources>

                    <HierarchicalDataTemplate DataType="{x:Type assets:AssetNode}"
                                              ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal">

                            <StackPanel.ContextMenu>
                                <ContextMenu
                                        DataContext="{Binding PlacementTarget.DataContext,
                                        RelativeSource={RelativeSource Self}}">

                                    <MenuItem Header="Create"
                                              Visibility="{Binding IsFolder,
                                              Converter={StaticResource BoolToVisibilityConverter}}">
                                          
                                        <MenuItem Header="Folder"
                                                  Click="NewFolder_Click"/>

                                        <Separator/>

                                        <MenuItem Header="Entity"
                                                  Click="CreateEntity_Click"/>

                                        <MenuItem Header="Animation"
                                                  Click="CreateAnimation_Click"/>

                                        <MenuItem Header="Tile"
                                                  Click="CreateTile_Click"/>

                                        <MenuItem Header="Trap"
                                                  Click="CreateTrap_Click"/>

                                        <MenuItem Header="Interactable"
                                                  Click="CreateInteractable_Click"/>
                                    </MenuItem>

                                    <MenuItem Header="Add"
                                              Visibility="{Binding IsFolder,
                                                          Converter={StaticResource BoolToVisibilityConverter}}">
                                        
                                        <MenuItem  Header="From Json File" 
                                                   Click="AddFile_Click"/>
                                    </MenuItem>
                                    
                                    <Separator/>

                                    <MenuItem Header="Rename"
                                              Click="Rename_Click"
                                              IsEnabled="{Binding IsSystem,
                                                          Converter={StaticResource InverseBoolConverter}}"/>

                                    <MenuItem Header="Delete"
                                              Click="Delete_Click"
                                              IsEnabled="{Binding IsSystem,
                                                          Converter={StaticResource InverseBoolConverter}}"/>   

                                    <Separator/>

                                    <MenuItem Header="Show in Explorer"
                                              Click="ShowInExplorer_Click"/>
                                </ContextMenu>
                            </StackPanel.ContextMenu>

                            <TextBlock Text="{Binding Type,
                                       Converter={StaticResource IconConverter}}"
                                       Margin="0,0,6,0"/>

                            <TextBlock Text="{Binding Name}"
                                       Foreground="White"/>

                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.Resources>
            </TreeView>

        </Grid>
    </Border>
</UserControl>