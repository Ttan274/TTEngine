<UserControl x:Class="TTEngine.Editor.Panels.InspectorViews.TileInspectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Background="#2B2B2B" Padding="10">
        <StackPanel>

            <TextBlock Text="Tile"
                       FontWeight="Bold"
                       FontSize="14"
                       Foreground="White"
                       Margin="0,0,0,6"/>

            <TextBlock Text="Position" Foreground="Gray"/>
            <TextBlock Text="{Binding X, StringFormat=X: {0}}" Foreground="LightGray"/>
            <TextBlock Text="{Binding Y, StringFormat=Y: {0}}" Foreground="LightGray"/>

            <Separator Margin="0,6"/>

            <TextBlock Text="Tile ID" Foreground="Gray"/>
            <TextBlock Text="{Binding TileId}" Foreground="LightGray"/>

            <Separator Margin="0,6"/>

            <TextBlock Text="Tile Type" Foreground="Gray"/>
            <TextBlock Text="{Binding TileType}" Foreground="LightGray"/>

            <TextBlock Text="Collision" Foreground="Gray" Margin="0,4,0,0"/>
            <TextBlock Text="{Binding CollisionType}" Foreground="LightGray"/>

        </StackPanel>
    </Border>
</UserControl>
