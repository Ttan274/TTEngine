<UserControl x:Class="TTEngine.Editor.Panels.InspectorViews.GenericInspectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TTEngine.Editor.ViewModels.Panel"
             Background="#2B2B2B">

    <UserControl.Resources>

        <!-- STRING TEMPLATE -->
        <DataTemplate x:Key="StringTemplate">
            <TextBox Text="{Binding StringValue,
                            Mode=TwoWay,
                            UpdateSourceTrigger=LostFocus}"
                     Background="#3A3A3A"
                     Foreground="White"
                     BorderBrush="#555"/>
        </DataTemplate>

        <!-- NUMBER TEMPLATE -->
        <DataTemplate x:Key="NumberTemplate">
            <TextBox Text="{Binding StringValue,
                            Mode=TwoWay,
                            UpdateSourceTrigger=LostFocus}"
                     Background="#3A3A3A"
                     Foreground="White"
                     BorderBrush="#555"/>
        </DataTemplate>

        <!-- BOOL TEMPLATE -->
        <DataTemplate x:Key="BoolTemplate">
            <CheckBox IsChecked="{Binding StringValue,
                                  Mode=TwoWay}"
                      VerticalAlignment="Center"/>
        </DataTemplate>

        <!-- ENUM TEMPLATE -->
        <DataTemplate x:Key="EnumTemplate">
            <ComboBox ItemsSource="{Binding EnumValues}"
                      SelectedItem="{Binding StringValue,
                                     Mode=TwoWay}"
                      Background="#3A3A3A"
                      Foreground="White"/>
        </DataTemplate>

        <!-- TEMPLATE SELECTOR -->
        <local:PropertyEditorTemplateSelector x:Key="EditorSelector"
                                              StringTemplate="{StaticResource StringTemplate}"
                                              NumberTemplate="{StaticResource NumberTemplate}"
                                              BoolTemplate="{StaticResource BoolTemplate}"
                                              EnumTemplate="{StaticResource EnumTemplate}"/>

    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" 
                      Grid.Row="0">

            <ItemsControl ItemsSource="{Binding Inspector.Fields}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>

                        <Grid Margin="0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- LABEL -->
                            <TextBlock Text="{Binding DisplayName}"
                                Foreground="White"
                                VerticalAlignment="Center"
                                Margin="0,0,8,0"/>

                            <!-- EDITOR -->
                            <ContentControl Grid.Column="1"
                                     Content="{Binding}"
                                     ContentTemplateSelector="{StaticResource EditorSelector}"/>
                        </Grid>

                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </ScrollViewer>

        <!---Save Button-->
        <Border Grid.Row ="1"
                Background="#1E1E1E"
                Padding="10"
                BorderBrush="#333"
                BorderThickness="0,1,0,0">

            <Button Content="Save"
                    HorizontalAlignment="Right"
                    Width="100"
                    Click="Save_Click"/>

        </Border>
    </Grid>
</UserControl>