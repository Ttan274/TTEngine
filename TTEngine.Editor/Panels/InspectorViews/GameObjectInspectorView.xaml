<UserControl x:Class="TTEngine.Editor.Panels.InspectorViews.GameObjectInspectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:TTEngine.Editor.Panels.InspectorViews"
             Background="#2B2B2B">

    <StackPanel>

        <!--Root Field-->
        <views:GenericInspectorView DataContext="{Binding RootInspector}"/>

        <!--Components-->
        <ItemsControl ItemsSource="{Binding Components}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>

                    <Expander IsExpanded="True"
                              Margin="0,6">

                        <Expander.Header>
                            <DockPanel>
                                <TextBlock Text="{Binding Type}"
                                           VerticalAlignment="Center"
                                           Foreground="White"
                                           DockPanel.Dock="Left"/>

                                <Button    Content="X"
                                           Width="20"
                                           Height="20"
                                           Margin="0,6,0,0"
                                           DockPanel.Dock="Right"
                                           IsEnabled="{Binding IsRemovable}"
                                           Click="RemoveComponent_Click"/>
                            </DockPanel>
                        </Expander.Header>

                        <views:GenericInspectorView 
                            DataContext="{Binding Inspector}"/>

                    </Expander>
                    
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ComboBox x:Name="ComponentDropdown"
                  Margin="0,10,0,0"
                  DisplayMemberPath="TypeName"
                  SelectionChanged="ComponentDropdown_SelectionChanged">
            
        </ComboBox>
    </StackPanel>
</UserControl>
