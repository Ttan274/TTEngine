<UserControl x:Class="TTEngine.Editor.Panels.InspectorViews.SceneObjectInspector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="#2B2B2B" Padding="10">
        <StackPanel>
            
            <TextBlock  Text="Scene Object"
                        FontWeight="Bold"
                        FontSize="14"
                        Foreground="White"
                        Margin="0,0,0,6"/>

            <TextBlock Text="Position" Foreground="Gray"/>
            <TextBlock Text="{Binding X, StringFormat=X: {0}}" Foreground="LightGray"/>
            <TextBlock Text="{Binding Y, StringFormat=Y: {0}}" Foreground="LightGray"/>

            <Separator Margin="0,3"/>

            <TextBlock Text="Prefab ID" Foreground="Gray"/>
            <TextBlock Text="{Binding PrefabId}" Foreground="LightGray"/>

            <Separator Margin="0,3"/>

        </StackPanel>
    </Border>
</UserControl>
