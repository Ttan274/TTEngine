<UserControl x:Class="TTEngine.Editor.Panels.TileToolPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Background="#2B2B2B" Padding="10">
        <StackPanel>

            <!-- TILE PALETTE -->
            <TextBlock Text="Tiles"
                       FontWeight="Bold"
                       Foreground="White"
                       Margin="0,0,0,6"/>

            <ItemsControl   x:Name="TilePalette"
                            ItemsSource="{Binding Definition.TileDefinitions}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="40"
                                Height="40"
                                Margin="4"
                                Tag="{Binding Id}"
                                BorderThickness="1"
                                BorderBrush="DimGray"
                                Background="#2D2D2D"
                                MouseLeftButtonDown="OnTileClicked"
                                ToolTip="{Binding Name}"
                                Loaded="TileButtonLoaded">
                            <Image      Stretch="Uniform"
                                        Loaded="TileImageLoaded"/>

                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Separator Margin="0,8,0,8"/>

            <!-- GAMEOBJECT PALETTE-->
            <TextBlock  Text="GameObjects"
                        FontWeight="Bold"
                        Foreground="White"
                        Margin="0,0,0,6"/>

            <ItemsControl ItemsSource="{Binding Definition.GameObjects}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="40"
                                Height="40"
                                Margin="4"
                                Tag="{Binding Id}"
                                BorderThickness="1"
                                BorderBrush="DimGray"
                                Background="#2D2D2D"
                                MouseLeftButtonDown="OnPrefabClicked"
                                ToolTip="{Binding Id}"
                                Loaded="PrefabButtonLoaded">
                            <Image      Stretch="Uniform"
                                        Loaded="PrefabImageLoaded"/>

                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- BRUSH SIZE -->
            <TextBlock Text="Brush Size"
                       FontWeight="Bold"
                       Foreground="White"
                       Margin="0,8,0,4"/>

            <TextBlock x:Name="BrushSizeLabel"
                       Text="Size: 1x1"
                       Foreground="LightGray"
                       Margin="0,0,0,4"/>

            <Slider Minimum="1"
                    Maximum="3"
                    TickFrequency="1"
                    IsSnapToTickEnabled="True"
                    ValueChanged="BrushSize_ValueChanged"/>

            <Separator Margin="0,8,0,8"/>

            <!-- TOOLS -->
            <TextBlock Text="Tools"
                       FontWeight="Bold"
                       Foreground="White"
                       Margin="0,0,0,4"/>

            <RadioButton Content="Brush"
                         GroupName="ToolGroup"
                         Foreground="White"
                         IsChecked="True"
                         Checked="Brush_Checked"/>

            <RadioButton Content="Fill"
                         GroupName="ToolGroup"
                         Foreground="White"
                         Margin="0,2,0,0"
                         Checked="Fill_Checked"/>

            <Separator/>

            <!-- ACTIONS -->
            <Button x:Name="RunBtn"
                    Content="Start Game"
                    Margin="0,10,0,0"
                    Click="StartGame_Click"/>
            
            <Button Content="Build Game"
                    Margin="0,10,0,0"
                    Click="BuildGame_Click"/>

        </StackPanel>
    </Border>
</UserControl>
