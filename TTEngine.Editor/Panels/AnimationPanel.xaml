<UserControl x:Class="TTEngine.Editor.Panels.AnimationPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10" Width="280" Background="Wheat">

            <TextBlock Text="Animation Definition"
                       FontSize="14"
                       FontWeight="Bold"
                       Margin="0,0,0,10"/>

            <!-- ID -->
            <TextBlock Text="Animation Id"/>
            <TextBox Text="{Binding Id}" Margin="0,0,0,8"/>

            <!-- Sprite Sheet -->
            <TextBlock Text="Sprite Sheet"/>
            <StackPanel Orientation="Horizontal">
                <TextBox Text="{Binding SpriteSheetPath}" Width="200" IsReadOnly="True"/>
                <Button Content="..."
                        Width="40"
                        Margin="4,0,0,0"
                        Click="BrowseSpriteSheet"/>
            </StackPanel>

            <!-- Frame Settings -->
            <TextBlock Text="Frame Settings"
                       FontWeight="Bold"
                       Margin="0,10,0,4"/>

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="W"/>
                <TextBox Width="50"
                         Text="{Binding FrameWidth, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="H" Margin="6,0,0,0"/>
                <TextBox Width="50"
                         Text="{Binding FrameHeight, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <TextBlock Text="Frame Count"/>
            <TextBox Text="{Binding FrameCount, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Text="Frame Time (sec)"/>
            <TextBox Text="{Binding FrameTime, UpdateSourceTrigger=PropertyChanged}"/>

            <CheckBox Content="Loop"
                      IsChecked="{Binding Loop}"
                      Margin="0,6,0,6"/>

            <!-- Preview -->
            <TextBlock Text="Preview"
                       FontWeight="Bold"
                       Margin="0,8,0,4"/>

            <Border BorderBrush="#666"
                    BorderThickness="1"
                    Height="120">
                <Image x:Name="PreviewImage"
                       Stretch="Uniform"/>
            </Border>

            <StackPanel Orientation="Horizontal"
                        Margin="0,6,0,0">
                <Button Content="◀" Width="30" Click="PrevFrameClick"/>
                <Button Content="▶" Width="30" Margin="4,0,0,0" Click="NextFrameClick"/>
                <Button Content="Play" Width="60" Margin="6,0,0,0" Click="PlayClick"/>
                <Button Content="Stop" Width="60" Margin="4,0,0,0" Click="StopClick"/>
            </StackPanel>

            <!-- Timeline -->
            <TextBlock Text="Timeline"
                       FontWeight="Bold"
                       Margin="0,10,0,4"/>

            <ItemsControl x:Name="TimelineItemsControl">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <Button Content="Save Animation"
                    Margin="0,12,0,0"
                    Click="SaveClicked"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>