<UserControl x:Class="TTEngine.Editor.Panels.HierarchyPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
   
    <Border Background="#2B2B2B" Padding="6">
        <StackPanel>
            <TextBlock  Text="Hierarchy"
                        Foreground="White"
                        FontWeight="Bold"
                        Margin="0,0,0,6"/>

            <ListBox ItemsSource="{Binding SceneSession.ActiveScene.SceneObjects}"
                     SelectedItem="{Binding SceneSession.SelectedObject, Mode=TwoWay}"
                     Background="#1E1E1E"
                     BorderBrush="#444"
                     Foreground="White"
                     KeyDown="HierarchyKeyDown">

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock  Text="{Binding PrefabId}" Padding="4"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                
            </ListBox>
        </StackPanel>
    </Border>
</UserControl>
