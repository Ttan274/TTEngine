<UserControl x:Class="TTEngine.Editor.Panels.InspectorPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TTEngine.Editor.Models.Selection"
             xmlns:views="clr-namespace:TTEngine.Editor.Panels.InspectorViews">

    <UserControl.Resources>
        
        <!--  Map Selections -->
        
        <DataTemplate DataType="{x:Type vm:TileSelectionViewModel}">
            <views:TileInspectorView/>
        </DataTemplate>
        
        <DataTemplate DataType="{x:Type vm:SceneObjectSelectionViewModel}">
            <views:SceneObjectInspector/>
        </DataTemplate>

        <!--Asset Selection-->
        <DataTemplate DataType="{x:Type vm:TileAssetSelectionViewModel}">
            <views:GenericInspectorView DataContext="{Binding Inspector}"/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:GameObjectAssetSelectionViewModel}">
            <views:GameObjectInspectorView/>
        </DataTemplate>

    </UserControl.Resources>

    <Grid Background="#2B2B2B">
        <ContentControl Content="{Binding CurrentSelection}" />
    </Grid>
</UserControl>
